// ------------  Paquete e importaciones ------------
package Compilador;

import java_cup.runtime.*;


//------> Codigo para el parser
//------> Declaracion de variables, funciones y funciones de error

parser code 
{:
    public String resultado = ""; 

    public void syntax_error(Symbol s)
    {
            System.err.println("Error Sintactico: "+ s.value + " - Fila: " + s.right + " - Columna: " + s.left + ". Recuperado" );
    }

    public void unrecovered_syntax_error(Symbol s) throws java.lang.Exception
    {
            System.err.println("Error Sintactico: "+ s.value + " - Fila: " + s.right + " - Columna: " + s.left + ". Sin recuperacion." );
    }

:}


//------> Codigo para las acciones gramaticales (no tocar)
action code
{:  :}


//------> Declaración de terminales
terminal String DOUBLE, CADENA, ID;
terminal String VAR, PROGRAM, END, ARR, SUM, RES, MUL, DIV, MOD, MEDIA, MEDIANA, MODA, VARIANZA, MAX, MIN, CONSOLE, CHAR, DOUB, PRINT, COLUMN;
terminal String PARIZQ, PARDER, CORIZQ, CORDER, DOSP, DOSPD, COMA, PYC, FLECHA, FLECHAD, ARROBA, IGUAL, MENORQUE, MAYORQUE, EXCL, SALTO;


//------> Declaración de no terminales
non terminal inicio;
non terminal codigo, lista_instruccion, lista_expresion;
non terminal comentarios, simples, multilineas;
non terminal instruccion, expresion, variable, print, arreglos, tipo, arrays, column;



//------> Definir Simbolo Inicial
start with inicio; 


// ------------>  Producciones  <------------

inicio ::= PROGRAM codigo END PROGRAM PYC
;

codigo ::= lista_instruccion
;

lista_instruccion ::= lista_instruccion instruccion
    | instruccion
;

instruccion ::= variable
    | print
    | column
    | arreglos
    | expresion
    | error PYC
;

variable ::= VAR DOSP tipo DOSPD expresion:val1 FLECHA expresion:val2 END PYC   
;

arreglos ::= ARR DOSP tipo DOSPD ARROBA expresion:val FLECHA CORIZQ arrays CORDER END PYC
;

tipo ::= CHAR
    | DOUB
;

print ::= CONSOLE DOSPD PRINT IGUAL arrays:val END PYC
;

column ::= CONSOLE DOSPD COLUMN IGUAL expresion FLECHAD arrays END PYC
;

arrays ::= arrays COMA expresion:val
    | expresion:val
    | CORIZQ arrays CORDER
;

expresion ::=   DOUBLE:val          {: RESULT = val.toString(); System.out.println(val);  :}
        |       CADENA:val          {: RESULT = val.toString(); System.out.println(val); :}
        |       ID:val              {: RESULT = val.toString(); System.out.println(val); :}
        |       SUM PARIZQ expresion:izq COMA expresion:der PARDER  {: RESULT = util.Expresion.suma(izq.toString(), der.toString()); :}
        |       RES PARIZQ expresion:izq COMA expresion:der PARDER  {: RESULT = util.Expresion.resta(izq.toString(), der.toString()); :}
        |       MUL PARIZQ expresion:izq COMA expresion:der PARDER  {: RESULT = util.Expresion.multiplicacion(izq.toString(), der.toString()); :}
        |       DIV PARIZQ expresion:izq COMA expresion:der PARDER  {: RESULT = util.Expresion.division(izq.toString(), der.toString()); :}
        |       MOD PARIZQ expresion:izq COMA expresion:der PARDER  {: RESULT = util.Expresion.modulo(izq.toString(), der.toString()); :}

;